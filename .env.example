# Puerto del servidor (por defecto 3000)
PORT=3000

# Clave secreta JWT para la firma de tokens de autenticación en Dokploy
JWT_SECRET=colores-dayam-dokploy-secret-2026-key

# Clave opcional de Gemini API si deseas habilitar la generación de colores con IA
VITE_GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# (Opcional) URL base de la API si se despliega en subdominio separado
# VITE_API_URL=https://mi-api.dokploy.midominio.com
